# Required
BITBUCKET_URL=https://bitbucket.example.com
BITBUCKET_TOKEN=your-personal-access-token

# Optional — TLS (default: verify certificates)
# BITBUCKET_INSECURE_SSL=true

# Optional — HTTP client tuning
# BITBUCKET_TIMEOUT_MS=30000
# BITBUCKET_MAX_RETRIES=2

# Optional — transport (default: stdio)
# MCP_TRANSPORT=http
# PORT=3000
# MCP_ENDPOINT=/mcp
