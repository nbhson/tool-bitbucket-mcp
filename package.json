{
  "name": "@nbhson43/s-bitbucket-mcp-server",
  "version": "1.5.0",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "bitbucket-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "node build/index.js --http",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src && tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\""
  },
  "keywords": [
    "bitbucket",
    "mcp",
    "model-context-protocol",
    "atlassian",
    "devtools"
  ],
  "author": "",
  "license": "MIT",
  "description": "MCP server for Bitbucket Server integration",
  "repository": {
    "type": "git",
    "url": "https://bitbucket.org/nbhson/tool-bitbucket-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.0",
    "dotenv": "^17.4.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.13.0",
    "@typescript-eslint/eslint-plugin": "^8.25.0",
    "@typescript-eslint/parser": "^8.25.0",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.20.0",
    "eslint-plugin-import-x": "^4.6.1",
    "globals": "^15.14.0",
    "prettier": "^3.5.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.25.0",
    "vitest": "^5.0.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
