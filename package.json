{
  "name": "sbitbucket-mcp-server",
  "version": "1.4.0",
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "bitbucket-mcp": "build/index.js"
  },
  "files": [
    "build",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node build/index.js",
    "start:http": "node build/index.js --http",
    "dev": "tsc --watch",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,md}\""
  },
  "keywords": [
    "bitbucket",
    "mcp",
    "model-context-protocol",
    "atlassian",
    "devtools"
  ],
  "author": "",
  "license": "MIT",
  "description": "MCP server for Bitbucket Server integration",
  "repository": {
    "type": "git",
    "url": "https://github.com/nbhson/tool-bitbucket-mcp.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "@vitest/coverage-v8": "^4.1.10",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
